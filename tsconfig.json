{
    "compilerOptions": {
        "target": "es2017",
        "module": "esnext",
        "sourceMap": true,
        "outDir": "./dist",
        "moduleResolution": "bundler",
        "removeComments": true,
        "strict": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "types": ["@overwolf/types", "node"],
        "rootDir": "./src"
    },
    "include": ["src/**/*.ts"]
}
